# 复制本文件为 .env 后填写，切勿将真实密钥提交到仓库。
# 本机无 Docker 时，可通过 Unix socket 连接本地 Postgres（将 POSTGRES_HOST 留空）。

# Postgres
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=policy_qa
POSTGRES_USER=box
POSTGRES_PASSWORD=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# 阿里云 DashScope（qwen / gte-rerank / embedding）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek 仅用于行判或备用，不用于 E0 embedding 选型
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Langfuse Cloud（本阶段不接入，仅预留变量名）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# E0 锁定后填写；未锁定前不要臆造模型名或维度
EMBEDDING_MODEL=
EMBEDDING_DIM=
RERANK_MODEL=gte-rerank
QWEN_FAST_MODEL=qwen-turbo
QWEN_STRONG_MODEL=qwen-plus

# 应用
APP_HOST=127.0.0.1
APP_PORT=8000
