# 复制本文件为 .env 后填写，切勿将真实密钥提交到仓库，也不要贴到聊天里。
#
# 路径说明（Windows）：
# - POLICY_QA_HOME 默认 D:/policy-qa，虚拟环境和数据库都放这里，不要默认装到 C 盘。
# - 虚拟环境建议：python -m venv D:/policy-qa/.venv
#   若使用已有 conda，请用 --prefix 建到 D:/policy-qa/conda-env，不要装进 base，也不要默认写到 C 盘。
# - 数据库文件：D:/policy-qa/data/policy_qa.sqlite
# - 语料在本仓库的 corpus/ 目录，不复制到 C 盘。
# Linux / 本仓库开发机把 POLICY_QA_HOME 换成相应目录即可，例如 $HOME/policy-qa。

POLICY_QA_HOME=D:/policy-qa

# 阿里云 DashScope（embedding / 后续生成与 rerank）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek 仅用于评判或备用，第一段不调用
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Embedding 已锁定（2026-11-18 E0 实测，见 docs/embedding-lock.md）。维度从本配置读取，不写死在建表语句中。
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
RERANK_MODEL=gte-rerank

# qwen-turbo 已于 2026-10-10 官方下线，改用 qwen3.8-flash（compatible-mode，enable_thinking=False）级联 qwen-plus。
QWEN_FAST_MODEL=qwen3.8-flash
QWEN_STRONG_MODEL=qwen-plus

# 应用。Streamlit 由 python -m app.start 固定监听 127.0.0.1。
APP_HOST=127.0.0.1
APP_PORT=8000
STREAMLIT_PORT=8501
